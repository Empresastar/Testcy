<!DOCTYPE html>
<html>
<head>
    <title>HOST - CONTROLE DE QUÓRUM</title>
    <script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
    <style>
        body { background: #050505; color: #eee; font-family: monospace; padding: 20px; }
        .panel { border: 2px solid #222; background: #0a0a0a; padding: 20px; border-radius: 10px; max-width: 800px; margin: auto; }
        #log { height: 400px; overflow-y: auto; background: #000; padding: 15px; border: 1px solid #333; margin-top: 10px; }
        .verde { color: #00ff00; } .vermelho { color: #ff0000; } .roxo { color: #bf00ff; } .amarelo { color: #ffff00; }
        .status-bar { display: flex; justify-content: space-between; margin-bottom: 10px; font-weight: bold; }
    </style>
</head>
<body>
    <div class="panel">
        <h2>🖥️ CENTRAL DE QUÓRUM</h2>
        <div class="status-bar">
            <div id="status">OFFLINE</div>
            <div id="count">Pessoas Online: 0</div>
        </div>
        <button onclick="limpar('chat')" style="background:#800; color:white; border:none; padding:10px; cursor:pointer;">LIMPAR CHAT</button>
        <button onclick="limpar('livro')" style="background:#004d40; color:white; border:none; padding:10px; cursor:pointer;">LIMPAR LIVROS</button>
        <div id="log"></div>
    </div>

    <script>
        const peer = new Peer("CYBER_PRO_SERVER_2026");
        let db = { chat: [], urna: [], livro: [] };
        let conns = [];

        peer.on('open', id => { 
            document.getElementById('status').innerHTML = "<span class='verde'>ONLINE</span>";
            log("Servidor iniciado.");
        });

        peer.on('connection', c => {
            conns.push(c);
            updateUI();
            log(`<span class="verde">✅ Conectado: ${c.peer}</span>`);
            
            c.on('open', () => c.send({ type: 'SYNC', data: db }));
            
            c.on('close', () => {
                conns = conns.filter(conn => conn.peer !== c.peer);
                updateUI();
                log(`<span class="vermelho">🟥 tal id caiu: ${c.peer}</span>`);
            });

            c.on('data', d => {
                if(d.type === 'CHAT') {
                    db.chat.push({ id: Date.now(), msg: d.msg });
                    log(`<span class="amarelo">💬 ${c.peer}: ${d.msg}</span>`);
                }
                
                if(d.type === 'PROPOSE') {
                    // Adiciona controle de quem já votou
                    d.pl.quemVotou = [];
                    db.urna.push(d.pl);
                    log(`<span class="roxo">📋 Nova Lei: ${d.pl.t}</span>`);
                }

                if(d.type === 'VOTE') {
                    let pl = db.urna.find(x => x.id === d.id);
                    if(pl && !pl.quemVotou.includes(c.peer)) {
                        pl.quemVotou.push(c.peer);
                        d.voto === 'SIM' ? pl.sim++ : pl.nao++;
                        log(`<span class="roxo">🗳️ Voto de ${c.peer} (Total: ${pl.quemVotou.length}/${conns.length})</span>`);
                        
                        // SÓ FINALIZA SE TODOS VOTAREM
                        if(pl.quemVotou.length >= conns.length) {
                            if(pl.sim > pl.nao) {
                                db.livro.push(pl);
                                log(`<span class="verde">✨ Lei Aprovada por unanimidade/maioria!</span>`);
                            } else {
                                log(`<span class="vermelho">❌ Lei Reprovada.</span>`);
                            }
                            db.urna = db.urna.filter(x => x.id !== d.id);
                        }
                    }
                }
                broadcast();
            });
        });

        function updateUI() { document.getElementById('count').innerText = "Pessoas Online: " + conns.length; }
        function broadcast() { conns.forEach(c => c.open && c.send({ type: 'SYNC', data: db })); }
        function limpar(t) { t === 'chat' ? db.chat = [] : db.livro = []; broadcast(); }
        function log(m) { const l = document.getElementById('log'); l.innerHTML += `<div>${m}</div>`; l.scrollTop = l.scrollHeight; }
    </script>
</body>
</html>
